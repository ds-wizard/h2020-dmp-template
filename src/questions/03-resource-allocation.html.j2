{#- data -#}
{%- set adminInfo = x.administrativeInformation -%}
{%- set preserving = x.preservingData -%}
<div id="q-resource-allocation" class="question">
  <div class="answer">

  <p>{% trans %}FAIR is a central part of our data management; it is considered at every decision in our data management plan. We use the FAIR data process ourselves to make our use of the data as efficient as possible.{% endtrans %}</p> 

  {# Costs #}
    {%- set projectItems = adminInfo.projects -%}
    {%- if projectItems|length > 0 -%}
    <ul>
        {%- for project in projectItems -%}
            {%- set projectItemNameReply = project.name._value -%}
              <li>
                <strong>{{ projectItemNameReply if projectItemNameReply else _("(no name given)") }}</strong>
                {%- set projectCostItems = project.costs -%}

                {%- if projectCostItems|length > 0  -%}
                <p>{% trans %}The following resources will be dedicated to data management and ensuring that data will be FAIR:{% endtrans %}</p>
                    <ul>
                    {%- for cost in projectCostItems -%}
                        {#- the title question is not in every knowledge model -#}
                        {%- set projectCostItemTitleReply = cost.title._value if cost.title is defined else none -%}
                        {%- set projectCostItemDescriptionReply = cost.description._value -%}
                        <li>
                        {#- the title is often left unanswered; the description stands in for it -#}
                        {%- if projectCostItemTitleReply %}
                        <strong>{{ projectCostItemTitleReply }}</strong>
                        {%- if projectCostItemDescriptionReply %} &ndash; {{ projectCostItemDescriptionReply|trim|dot }}{% endif -%}
                        {%- elif projectCostItemDescriptionReply %}
                        {{ projectCostItemDescriptionReply|trim|dot }}
                        {%- else %}
                        <strong>{% trans %}(no name given){% endtrans %}</strong>
                        {%- endif -%}

                        {%- set projectCostItemCurrency = cost.currency -%}

                        {%- set projectCostItemAmountReply = cost.amount._value -%}

                        {#- a number (0 is an amount too) -#}
                        {%- if  projectCostItemAmountReply is not none and projectCostItemAmountReply != '' and projectCostItemCurrency._value is not none -%}
                            <p>{% trans amount=projectCostItemAmountReply, currency=(macros.currency(projectCostItemCurrency)) %}The amount is {{ amount }} {{ currency }}.{% endtrans %}</p>
                        {%- endif -%}

                        {%- set projectCostItemAllocationItems = cost.allocation|map(attribute='_value')|list -%}

                        
                          {%- set projectCostItemAllocations = [] -%}
                          {%- if 'findability' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring findability")) -%}
                          {%- endif -%}
                          {%- if 'accessibility' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring accessibility")) -%}
                          {%- endif -%}
                          {%- if 'interoperability' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring interoperability")) -%}
                          {%- endif -%}
                          {%- if 'reusability' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("ensuring reusability")) -%}
                          {%- endif -%}
                          {%- if 'management' in projectCostItemAllocationItems -%}
                            {%- do projectCostItemAllocations.append(_("supporting management")) -%}
                          {%- endif -%}
                        
                        {%- if projectCostItemAllocations|length > 0 -%}
                          {#- TRANSLATORS: %(purposes)s is an enumeration like "ensuring findability and ensuring accessibility" -#}
                          <p>
                            {% trans purposes=macros.joinAnd(projectCostItemAllocations) %}This resource is allocated for {{ purposes }} of data.{% endtrans %}
                          </p>
                        {%- endif -%}
 
                        {%- set coveredBy = cost.coveredBy -%}

                        {%- if coveredBy._value == 'grant' -%}
                          {#- the selected funding of the project -#}
                          {%- set funding = project.fundings|selectattr('_uuid', 'equalto', coveredBy.grantID.get('_uuid'))|first -%}
                          {%- set costCoverGrantIdReply = funding.grantNumber._value if funding else none -%}
                          {%- if costCoverGrantIdReply -%}
                            <p>{% trans grant=costCoverGrantIdReply %}This cost will be covered by a funding grant (grant number: {{ grant }}).{% endtrans %}</p>
                          {%- else -%}
                            <p>{% trans %}This cost will be covered by a funding grant.{% endtrans %}</p>
                          {%- endif -%}
                        {%- elif coveredBy._value == 'other' -%}
                          {%- set costCoverOtherHowReply = coveredBy.description._value -%}
                          {%- if costCoverOtherHowReply -%}
                            <p>{% trans value=(costCoverOtherHowReply|trim|dot) %}This cost will be covered as follows: {{ value }}{% endtrans %}</p>
                          {%- endif -%}
                        {%- endif -%}
                        </li>
                    {%- endfor -%}
                    </ul>
                {%- else -%}
                <p>{% trans %}Making our data FAIR is not a cost that can be separated from the rest of the project.{% endtrans %}</p>
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>
    {%- endif -%}

  {# Archiving #}
  {%- set coldStorageDuring = preserving.coldStorageDuringProject._value is true -%}
  {%- set coldStorageAfter = preserving.coldStorageAfterProject._value is true -%}

  {%- if coldStorageDuring and coldStorageAfter -%}
    <p>{% trans %}We will be archiving data in <em>cold storage</em> systems for long-term preservation after the project but also already during the project.{% endtrans %}</p>
  {%- elif coldStorageDuring -%}
    <p>{% trans %}We will be archiving data in <em>cold storage</em> systems for long-term preservation already during the project.{% endtrans %}</p>
  {%- elif coldStorageAfter -%}
    <p>{% trans %}We will be archiving data in <em>cold storage</em> systems for long-term preservation after the project.{% endtrans %}</p>
  {%- endif -%}
  
  {# Repository charges #}
  {%- set repoCharges = preserving.repositoryFees -%}
  {%- if repoCharges._value is false -%}
    <p>{% trans %}None of the used repositories charge for their services.{% endtrans %}</p>
  {%- elif repoCharges._value is true -%}
    {%- set repoChargesHowPay = repoCharges.paying._value -%}
    {%- if repoChargesHowPay == 'budget' -%}
      <p>{% trans %}We have budgeted for the costs in the project to pay charges of the used repositories.{% endtrans %}</p>
    {%- elif repoChargesHowPay == 'department' -%}
      <p>{% trans %}The costs related to the used repositories will be carried by (one of) the departments involved in the project.{% endtrans %}</p>
    {%- elif repoChargesHowPay == 'institute' -%}
      <p>{% trans %}The costs related to the used repositories will be carried by (one of) the institutes involved in the project.{% endtrans %}</p>
    {%- elif repoChargesHowPay == 'other' -%}
      {%- set repoChargesHowPayOther = repoCharges.paying.other._value -%}
      {%- if repoChargesHowPayOther -%}
        {% call macros.para() %}{% trans value=(repoChargesHowPayOther|markdown) %}We will carry the costs related to the used repositories by: {{ value }}{% endtrans %}{% endcall %}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  
  {# Budget time and effort #}
  {%- set budgetTimeEffort = preserving.hasDataPublicationBudget -%}
  {%- if budgetTimeEffort._value is true -%}
    <p>{% trans %}We have a reserved budget for the time and effort it will take to prepare the data for publication.{% endtrans %}</p>
  {%- endif -%}

  {# People #}

  {%- set contributorsItems = adminInfo.contributors -%}
  {%- if contributorsItems|length > 0 -%}
    {#- a paragraph about the contributors with the given role, the caller gets their names and count -#}
    {%- macro contributorsResponsibility(contributors, contributorRole) -%}
      {%- set names = [] -%}
      {%- for contributor in contributors -%}
        {%- set roles = contributor.roles|map(attribute='_value')|list -%}
        {%- set name = contributor.name._value -%}
        {%- if contributorRole in roles and name -%}
          {%- do names.append(name) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if names|length > 0 -%}
        <p>{{ caller(macros.joinAnd(names), names|length) }}
        </p>
      {%- endif -%}
    {%- endmacro -%}
    {# Data curators #}
    {% call(names, n) contributorsResponsibility(contributorsItems, 'dataCurator') %}{% trans count=n, names=names %}{{ names }} is responsible for reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use and maintenance within a data centre or repository.{% pluralize %}{{ names }} are responsible for reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use and maintenance within a data centre or repository.{% endtrans %}{% endcall %}
    {# Data collectors #}
    {% call(names, n) contributorsResponsibility(contributorsItems, 'dataCollector') %}{% trans count=n, names=names %}{{ names }} is responsible for finding, gathering, and collecting data.{% pluralize %}{{ names }} are responsible for finding, gathering, and collecting data.{% endtrans %}{% endcall %}
    {# Data managers #}
    {% call(names, n) contributorsResponsibility(contributorsItems, 'dataManager') %}{% trans count=n, names=names %}{{ names }} is responsible for maintaining the finished resource.{% pluralize %}{{ names }} are responsible for maintaining the finished resource.{% endtrans %}{% endcall %}
    {# Data stewards #}
    {% call(names, n) contributorsResponsibility(contributorsItems, 'dataSteward') %}{% trans count=n, names=names %}{{ names }} is responsible for the management and proficiency of data including data processing, data policies, data guidelines, and data availability.{% pluralize %}{{ names }} are responsible for the management and proficiency of data including data processing, data policies, data guidelines, and data availability.{% endtrans %}{% endcall %}
    {# Distributors #}
    {% call(names, n) contributorsResponsibility(contributorsItems, 'distributor') %}{% trans count=n, names=names %}{{ names }} is responsible for generating and disseminating copies of the resource in either electronic or print form.{% pluralize %}{{ names }} are responsible for generating and disseminating copies of the resource in either electronic or print form.{% endtrans %}{% endcall %}
    {# Data protection officers #}
    {% call(names, n) contributorsResponsibility(contributorsItems, 'dataProtectionOfficer') %}{% trans count=n, names=names %}{{ names }} is responsible for all issues relating to the protection of personal data and data protection policies in general.{% pluralize %}{{ names }} are responsible for all issues relating to the protection of personal data and data protection policies in general.{% endtrans %}{% endcall %}
    {# Creator of DMP #}
    {% call(names, n) contributorsResponsibility(contributorsItems, 'creatorOfDmp') %}{% trans count=n, names=names %}{{ names }} is responsible for implementing the DMP, and ensuring it is reviewed and revised.{% pluralize %}{{ names }} are responsible for implementing the DMP, and ensuring it is reviewed and revised.{% endtrans %}{% endcall %}
  {%- endif -%}

  {# additional expertise #}
  {%- set expertiseQ = adminInfo.requiresSpecialist -%}
  {%- set expertise = expertiseQ._value -%}
  {%- if expertise == 'no' -%}
    <p>{% trans %}To execute the DMP, no additional specialist expertise is required.{% endtrans %}</p>
  {%- elif expertise == 'available' -%}
    <p>{% trans %}To execute the DMP, additional specialist expertise is required and we have such trained support staff available.{% endtrans %}</p>
  {%- elif expertise == 'training' -%}
    {% call macros.para() %}
      {% trans %}To execute the DMP, additional specialist expertise is required. We will be training existing staff.{% endtrans %}
      {%- set expertiseTrainText = expertiseQ.training._value -%}
      {%- if expertiseTrainText %}
        {% trans value=(expertiseTrainText|markdown) %}The training will be: {{ value }}{% endtrans %}
      {%- endif -%}
    {% endcall %}
  {%- elif expertise == 'expertise' -%}
    <p>
      {% trans %}To execute the DMP, additional specialist expertise is required. We will be hiring new people with additional expertise.{% endtrans %}
      {%- set expertiseHireText = expertiseQ.expertise._value -%}
      {%- if expertiseHireText %}
        {% trans value=(expertiseHireText|trim|dot) %}The required expertise from new people is: {{ value }}{% endtrans %}
      {%- endif -%}
    </p>
  {%- endif -%}
  {# additional hw/sw #}
  {%- set additionalHWSW = adminInfo.requiresSpecialHardwareSoftware -%}
  {%- if additionalHWSW._value is false -%}
    <p>{% trans %}We do not require any hardware or software in addition to what is usually available in the institute.{% endtrans %}</p>
  {%- elif additionalHWSW._value is true -%}
    {%- set additionalHWSWWhat = additionalHWSW.needs._value -%}
    {%- if additionalHWSWWhat -%}
      {% call macros.para() %}{% trans value=(additionalHWSWWhat|markdown) %}We require the following hardware or software in addition to what is usually available in the institute: {{ value }}{% endtrans %}{% endcall %}
    {%- else -%}
      <p>{% trans %}We require hardware or software in addition to what is usually available in the institute.{% endtrans %}</p>
    {%- endif -%}
  {%- endif -%}
  </div>
</div>
