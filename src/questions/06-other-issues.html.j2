<div id="q-other-issues" class="question">
  <div class="answer">
    {%- set project_url = dc.config.client_url ~ "/projects/" ~ dc.project.uuid -%}
    {%- set serviceLink -%}<a href="{{ dc.config.service_url }}" target="_blank">{{ dc.config.service_name }}</a>{%- endset -%}
    {%- set packageId -%}<span class="package-id">{{ dc.km_package.id }}:{{ dc.km_package.version }}</span>{%- endset -%}
    {%- set instanceLink -%}<a href="{{ dc.config.client_url }}" target="_blank">{{ dc.config.client_url }}</a>{%- endset -%}
    {%- set projectLink -%}<a href="{{ project_url }}" target="_blank">{{ project_url }}</a>{%- endset %}
    {#- TRANSLATORS: %(service)s is the name of the Wizard as a link, %(instance)s the URL of the instance, %(project_url)s the URL of the project -#}
    {#- no project and package in a preview of the knowledge model editor #}
    {%- if dc.project and dc.km_package %}
    <p>{% trans service=serviceLink, name=dc.km_package.name, id=packageId, instance=instanceLink, service_name_short=dc.config.service_name_short, project_url=projectLink %}We use the {{ service }} with its <em>{{ name }}</em> (ID: {{ id }}) knowledge model to make our DMP. More specifically, we use the {{ instance }} {{ service_name_short }} instance where the project has the direct URL: {{ project_url }}.{% endtrans %}</p>
    {%- endif %}
  </div>
</div>
