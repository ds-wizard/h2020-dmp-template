    {%- endif -%}
  {%- elif reply and reply.value.value.type == "PlainType" -%}
    {{ reply.value.value.value }}
  {%- endif -%}
{%- endmacro -%}

{%- macro integrationValue(reply) -%}
    {{ reply.value.value.value }}
{%- endmacro -%}

{#- A paragraph whose content may contain block elements, e.g. a sentence ending with an answer in
    Markdown that has a list or several paragraphs:
      {% call macros.para() %}...: {{ value|markdown }}{% endcall %}
    The content is split into its top-level parts: every run of text becomes a paragraph (a lone "."
    or "," is dropped), every block element stays as it is; without blocks it is a plain <p>. -#}
{%- macro para() -%}
  {%- set blocks = ['p', 'ul', 'ol', 'blockquote', 'pre', 'table', 'div', 'h4'] -%}
  {%- set ns = namespace(rest=caller()|trim, parts=[]) -%}
  {%- for _ in range(1000) -%}
    {%- if not ns.rest -%}{%- break -%}{%- endif -%}
    {#- the first block element of the rest -#}
    {%- set first = namespace(i=-1, tag='') -%}
    {%- for tag in blocks -%}
      {%- for opening in ['<' ~ tag ~ '>', '<' ~ tag ~ ' '] -%}
        {%- set i = ns.rest.find(opening) -%}
        {%- if i >= 0 and (first.i < 0 or i < first.i) -%}
          {%- set first.i = i -%}
          {%- set first.tag = tag -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- set text = ns.rest if first.i < 0 else ns.rest[:first.i] -%}
    {%- if text|trim and text|trim not in ['.', ','] -%}
      {%- do ns.parts.append('<p>'|safe ~ text|trim ~ '</p>'|safe) -%}
    {%- endif -%}
    {%- if first.i < 0 -%}{%- break -%}{%- endif -%}
    {#- the end of that block element, counting nested elements of the same name -#}
    {%- set closing = '</' ~ first.tag ~ '>' -%}
    {%- set b = namespace(pos=first.i + 1, depth=1) -%}
    {%- for _ in range(1000) -%}
      {%- if b.depth == 0 -%}{%- break -%}{%- endif -%}
      {%- set e = ns.rest.find(closing, b.pos) -%}
      {%- set o = [ns.rest.find('<' ~ first.tag ~ '>', b.pos), ns.rest.find('<' ~ first.tag ~ ' ', b.pos)]|select('ge', 0)|list -%}
      {%- if e < 0 -%}
        {%- set b.pos = ns.rest|length -%}
        {%- break -%}
      {%- elif o and o|min < e -%}
        {%- set b.depth = b.depth + 1 -%}
        {%- set b.pos = o|min + 1 -%}
      {%- else -%}
        {%- set b.depth = b.depth - 1 -%}
        {%- set b.pos = e + closing|length -%}
      {%- endif -%}
    {%- endfor -%}
    {%- do ns.parts.append(ns.rest[first.i:b.pos]) -%}
    {%- set ns.rest = ns.rest[b.pos:]|trim -%}
  {%- endfor -%}
  {{ ns.parts|join }}
{%- endmacro -%}

{#- Items joined into an enumeration: "A", "A and B", "A, B, and C" -#}
{%- macro joinAnd(items) -%}
  {%- if items|length > 2 -%}
    {#- TRANSLATORS: the end of an enumeration of three or more items, e.g. "A, B, and C" -#}
    {{ _("%(items)s, and %(last)s", items=items[:-1]|join(", "), last=items[-1]) }}
  {%- elif items|length == 2 -%}
    {#- TRANSLATORS: an enumeration of two items, e.g. "A and B" -#}
    {{ _("%(first)s and %(last)s", first=items[0], last=items[1]) }}
  {%- elif items|length == 1 -%}
    {{ items[0] }}
  {%- endif -%}
{%- endmacro -%}

{#- Items joined into a negative enumeration after "neither": "A", "A nor B", "A, B, nor C" -#}
{%- macro joinNor(items) -%}
  {%- if items|length > 2 -%}
    {#- TRANSLATORS: a negative enumeration of three or more items after "neither", e.g. "neither A, B, nor C" -#}
    {{ _("%(items)s, nor %(last)s", items=items[:-1]|join(", "), last=items[-1]) }}
  {%- elif items|length == 2 -%}
    {#- TRANSLATORS: a negative enumeration of two items after "neither", e.g. "neither A nor B" -#}
    {{ _("%(first)s nor %(last)s", first=items[0], last=items[1]) }}
  {%- elif items|length == 1 -%}
    {{ items[0] }}
  {%- endif -%}
{%- endmacro -%}

{#- A date (and time) in the language of the document: month names and the order are
    translated, as strftime only knows English ("%d %b %Y" / "%d %B %Y" in English) -#}
{%- macro formatDate(value, full=false, time=false) -%}
  {%- if value -%}
    {%- set month = value|datetime_format("%m")|int -%}
    {%- set day = value|datetime_format("%d") -%}
    {%- set year = value|datetime_format("%Y") -%}
    {%- if full -%}
      {%- set months = [pgettext("month name in a date", "January"), pgettext("month name in a date", "February"), pgettext("month name in a date", "March"), pgettext("month name in a date", "April"), pgettext("month name in a date", "May"), pgettext("month name in a date", "June"), pgettext("month name in a date", "July"), pgettext("month name in a date", "August"), pgettext("month name in a date", "September"), pgettext("month name in a date", "October"), pgettext("month name in a date", "November"), pgettext("month name in a date", "December")] -%}
      {#- TRANSLATORS: the order of a date with the full month name, e.g. "05 October 2026"; [day] (05), [day_number] (5), [month] (the name), [month_number] (10) and [year] can be used -#}
      {%- set pattern = pgettext("date with a full month name", "[day] [month] [year]") -%}
    {%- else -%}
      {%- set months = [pgettext("short month name in a date", "Jan"), pgettext("short month name in a date", "Feb"), pgettext("short month name in a date", "Mar"), pgettext("short month name in a date", "Apr"), pgettext("short month name in a date", "May"), pgettext("short month name in a date", "Jun"), pgettext("short month name in a date", "Jul"), pgettext("short month name in a date", "Aug"), pgettext("short month name in a date", "Sep"), pgettext("short month name in a date", "Oct"), pgettext("short month name in a date", "Nov"), pgettext("short month name in a date", "Dec")] -%}
      {#- TRANSLATORS: the order of a short date, e.g. "05 Oct 2026"; [day] (05), [day_number] (5), [month] (the short name), [month_number] (10) and [year] can be used -#}
      {%- set pattern = pgettext("short date", "[day] [month] [year]") -%}
    {%- endif -%}
    {{ pattern|replace("[day_number]", day|int|string)|replace("[day]", day)|replace("[month_number]", month|string)|replace("[month]", months[month - 1])|replace("[year]", year) }}
    {%- if time %} {{ value|datetime_format("%H:%M:%S") }}{% endif -%}
  {%- endif -%}
{%- endmacro -%}
